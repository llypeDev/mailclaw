# Copy to .env.docker and edit, then `docker compose up -d --build`:
#   cp .env.docker.example .env.docker
#
# Loaded by docker-compose.yml (env_file). Commented lines fall back to the
# image defaults (see docs/self-hosting.md for the full reference).

# ===== Database =====
# SQLite in the data volume by default. Point at an external database instead
# (PostgreSQL, MySQL/MariaDB, libSQL/Turso); migrations run on start. See
# docs/databases.md for the drivers and what differs per database.
#DATABASE_URL=postgres://mailclaw:change-me@db:5432/mailclaw
#DATABASE_URL=mysql://mailclaw:change-me@db:3306/mailclaw
#DATABASE_URL=libsql://my-db.turso.io
#DATABASE_AUTH_TOKEN=

# ===== Basics =====
# Public URL behind a reverse proxy: password-reset links, the JMAP session
# and inbound webhooks all use it.
#APP_URL=https://mail.example.com
# Behind a reverse proxy, also set this, or every client shares the proxy's
# address and therefore one sign-in rate limit. The proxy must append the
# client address to X-Forwarded-For. Leave unset when exposed directly.
#TRUST_PROXY=1
# Address the HTTP server binds to (127.0.0.1 = only a proxy on this host).
#HOST=0.0.0.0

# ===== Inbound mail: pick one (both can be on at once) =====
# Built-in SMTP listener (default). Uncomment the "25:25" port mapping in
# docker-compose.yml, point the domain's MX at this host, and set
# MAIL_HOSTNAME to that host's name.
#SMTP_INBOUND_PORT=25
#MAIL_HOSTNAME=mail.example.com
#SMTP_INBOUND_HOST=0.0.0.0
# STARTTLS with your certificate (paths inside the container).
#SMTP_TLS_KEY=/data/tls/key.pem
#SMTP_TLS_CERT=/data/tls/cert.pem
#SMTP_MAX_SIZE=37748736

# Cloudflare Email Routing relay: keep MX on Cloudflare and deploy the Worker
# in deploy/cloudflare-email-relay. Disables the built-in listener.
#SMTP_INBOUND_PORT=0
# Shared HMAC secret; must match the relay Worker's INBOUND_WEBHOOK_SECRET
# (npx wrangler secret put INBOUND_WEBHOOK_SECRET).
#INBOUND_WEBHOOK_SECRET=change-me-to-a-long-random-string
# Once the relay Worker is current, refuse relays that do not sign the
# header map with a timestamp (those requests could be replayed).
#INBOUND_REQUIRE_SIGNED_HEADERS=1

# ===== Outbound mail: at least one =====
# Any SMTP relay (host, Amazon SES, Postmark, Mailgun, your own Postfix):
#SMTP_URL=smtps://user:pass@smtp.example.com:465
# Only for a relay with a self-signed certificate on a private network.
#SMTP_TLS_REJECT_UNAUTHORIZED=false

# Cloudflare Email Sending: the zone must have Email Sending enabled.
#CF_ACCOUNT_ID=
#CF_TOKEN=

# ===== Optional =====
# Zone management: with zone + Email Routing permissions, adding a domain in
# the app configures Email Routing and the sending subdomain automatically.
#CF_TOKEN=

# Resend / SES fallback credentials. Values saved on the domain page win.
#RESEND_API_KEY=
#AWS_ACCESS_KEY_ID=
#AWS_SECRET_ACCESS_KEY=
#AWS_REGION=

# Bot protection on login and reset forms (site key at build time via
# NEXT_PUBLIC_TURNSTILE_SITE_KEY).
#TURNSTILE_SECRET_KEY=

# Email assistant (OpenAI-compatible API).
#AI_BASE_URL=
#AI_API_KEY=
#AI_MODEL=gpt-4o-mini

# Web Push (browser notifications). Generate once with `npm run push:keys`
# and keep the same pair across upgrades.
#VAPID_PUBLIC_KEY=
#VAPID_PRIVATE_KEY=
#VAPID_SUBJECT=mailto:admin@example.com

# Native push to the iOS app: your Apple key (.p8 contents), or a push relay.
#APNS_KEY_ID=
#APNS_TEAM_ID=
#APNS_PRIVATE_KEY=
#APNS_RELAY_URL=https://relay.example.com

# Spam lookups. Keys can also be set under Admin > Spam filter.
#SPAMHAUS_DQS_KEY=
#ABUSECH_AUTH_KEY=
# "off" disables the domain-age lookups to rdap.org.
#SPAM_DOMAIN_AGE_CHECK=off

# Object storage in Backblaze B2 or AWS S3 instead of files under /data/blobs.
#B2_KEY_ID=
#B2_APPLICATION_KEY=
#B2_BUCKET=
#B2_ENDPOINT=s3.us-west-004.backblazeb2.com
#S3_BUCKET=
#S3_REGION=
#S3_ACCESS_KEY_ID=
#S3_SECRET_ACCESS_KEY=

# SQLite tuning for large databases (built-in SQLite file only).
#SQLITE_CACHE_KB=65536
#SQLITE_MMAP_BYTES=268435456
#SQLITE_TEMP_STORE=memory
#SQLITE_SYNCHRONOUS=NORMAL
